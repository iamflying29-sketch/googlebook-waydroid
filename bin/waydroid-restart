#!/bin/bash
# Fully restart Android (use when Waydroid is frozen or misbehaving).
export XDG_RUNTIME_DIR="/run/user/$(id -u)"
export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}"

pkill -u "$(id -u)" -f '^/usr/bin/python3 /usr/bin/waydroid show-full-ui'
waydroid session stop
sudo -n systemctl restart waydroid-container
exec waydroid show-full-ui
